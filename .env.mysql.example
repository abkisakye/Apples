APP_NAME=Apples
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Africa/Kampala

BUSINESS_NAME="Apples Of Gold"
BUSINESS_TAGLINE="Business Management System"
BUSINESS_ADDRESS="Your business address"
BUSINESS_PHONE="+256700000000"
BUSINESS_EMAIL="info@example.com"
BUSINESS_TIN="TIN-NUMBER"
BUSINESS_CURRENCY=UGX
BUSINESS_RECEIPT_FOOTER="Thank you for your business."
BUSINESS_INVOICE_FOOTER="Please settle outstanding balances by the due date shown on this invoice."
BUSINESS_STATEMENT_FOOTER="This statement is system-generated and intended for account reconciliation."

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apples_prod
DB_USERNAME=apples_user
DB_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
